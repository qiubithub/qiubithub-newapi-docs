{
  "name": "qiubithub-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:www": "npm run dev -w @qiubithub/www",
    "dev:docs": "npm run dev -w @qiubithub/docs",
    "build:www": "npm run build -w @qiubithub/www",
    "build:docs": "npm run build -w @qiubithub/docs",
    "build": "npm run build:www && npm run build:docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "qa:install": "playwright install chromium",
    "qa:visual": "playwright test -c playwright.golden-pages.config.ts",
    "preview:www": "npm run preview -w @qiubithub/www",
    "preview:docs": "npm run preview -w @qiubithub/docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "start-server-and-test": "^2.0.10",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
